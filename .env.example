# Copy this file to .env and replace the placeholder with your actual key.
# .env is listed in .gitignore — never commit your real key.
#
# Get a free Groq API key (no credit card required) at:
# https://console.groq.com

GROQ_API_KEY=your_key_here

# --- ChromaDB ---
# Path where ChromaDB persists its data. Defaults to ./chroma_db
CHROMA_PATH=./chroma_db

# Name of the ChromaDB collection. Defaults to theunofficialguide
CHROMA_COLLECTION=theunofficialguide

# Set to "true" to wipe and rebuild the collection on the next run.
# When false (default), embedding is skipped if the collection is already populated.
FORCE_REBUILD=false
